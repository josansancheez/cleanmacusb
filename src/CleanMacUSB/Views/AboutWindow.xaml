<Window x:Class="CleanMacUSB.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[AboutWindowTitle]}"
        Icon="pack://application:,,,/Assets/CleanMacUSB.ico"
        Width="560"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera con Logo Macintosh y Créditos de Josan Sánchez -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/logo.png"
                       Width="72"
                       Height="72"
                       Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[AboutVersionText]}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Loc[AboutCopyrightText]}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Loc[AboutDescription]}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0">
                        <Run Text="{Binding Loc[SettingsRepoLabel], Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Run Text=" " />
                        <Hyperlink NavigateUri="https://github.com/josansancheez/cleanmacusb"
                                   Foreground="#0284C7"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            https://github.com/josansancheez/cleanmacusb
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Etiqueta Licencia -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Loc[AboutLicenseHeader]}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="2,14,0,6" />

        <!-- Cuadro del Contrato de Licencia (EULA) -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="4">
            <TextBox x:Name="EulaTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11.5"
                     Foreground="#334155"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10" />
        </Border>

        <!-- Botón Donar (PayPal) y Cerrar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{Binding Loc[BtnDonateCoffee]}"
                    ToolTip="{Binding Loc[DonateTooltip]}"
                    Style="{StaticResource FluentDonateButtonStyle}"
                    Padding="14,8"
                    Click="DonateButton_Click" />

            <Button Grid.Column="2"
                    Content="{Binding Loc[AboutCloseButton]}"
                    Style="{StaticResource FluentPrimaryButtonStyle}"
                    MinWidth="110"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
