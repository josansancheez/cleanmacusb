<Window x:Class="CleanMacUSB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMacUSB"
        Icon="pack://application:,,,/Assets/CleanMacUSB.ico"
        Width="820"
        Height="760"
        MinWidth="760"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. CABECERA PRINCIPAL ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo Macintosh + USB -->
                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/logo.png"
                       Width="54"
                       Height="54"
                       Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Título -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Loc[AppTitle]}"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Botón de Ajustes (con estado sombreado activo cuando estás dentro de Ajustes) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SettingsHeaderButton"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="36"
                            Padding="16,0"
                            Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,-1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[SettingsButton]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. CUERPO CENTRAL (INICIO / LOG / AJUSTES) ==================== -->
        <Grid Grid.Row="1">

            <!-- VISTA A: PANTALLA PRINCIPAL DE LIMPIEZA Y EXPULSIÓN -->
            <Grid x:Name="MainConfigPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Selector de Unidad USB / Disco Interno / Carpeta Específica -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[UsbSectionTitle]}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[UsbSectionSubtitle]}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="UsbDrivesComboBox"
                                      Grid.Column="0"
                                      Height="38"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      VerticalContentAlignment="Center"
                                      Padding="10,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="UsbDrivesComboBox_SelectionChanged">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="0,1,0,1"
                                                        Padding="10,5"
                                                        Margin="0,2,0,2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#0369A1" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>

                            <Button x:Name="RefreshDrivesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Click="RefreshDrivesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="15" FontWeight="Bold" Margin="0,-1,5,0" />
                                    <TextBlock Text="{Binding Loc[RefreshDrivesButton]}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BrowseFolderButton"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Click="BrowseFolderButton_Click">
                                <TextBlock Text="{Binding Loc[BrowseFolderButton]}" />
                            </Button>
                        </Grid>

                        <!-- Aviso al seleccionar un disco duro interno del ordenador -->
                        <Border x:Name="InternalDriveWarningBorder"
                                Background="#FFFBEB"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <TextBlock Text="{Binding Loc[InternalDriveWarning]}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#B45309"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock x:Name="NoDrivesWarningText"
                                   Text="{Binding Loc[NoUsbDetected]}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D97706"
                                   Margin="2,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Configuración de Limpieza (macOS + Windows + Linux + Smart TV) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera con título y botones Elegir todo / Desmarcar todo -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Loc[OptionsSectionTitle]}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="{Binding Loc[BtnSelectAll]}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="12"
                                        Margin="0,0,8,0"
                                        Click="SelectAllOptionsButton_Click" />

                                <Button Content="{Binding Loc[BtnDeselectAll]}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="12"
                                        Click="DeselectAllOptionsButton_Click" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,6,0">
                            <StackPanel>
                                <!-- Opción 1 (macOS): AppleDouble (._*) -->
                                <CheckBox x:Name="ChkAppleDouble"
                                          IsChecked="True"
                                          Margin="0,2,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeMacOs]}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptAppleDoubleTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptAppleDoubleDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 2 (macOS): .DS_Store -->
                                <CheckBox x:Name="ChkDsStore"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeMacOs]}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptDsStoreTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptDsStoreDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 3 (macOS): Spotlight, Trashes, fseventsd, TemporaryItems -->
                                <CheckBox x:Name="ChkSpotlightTrash"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeMacOs]}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptSpotlightTrashTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptSpotlightTrashDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 4 (Windows): Thumbs.db, desktop.ini, WPSettings.dat -->
                                <CheckBox x:Name="ChkWinCaches"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeWindows]}" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptWinCacheTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptWinCacheDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 5 (Windows): $RECYCLE.BIN, FOUND.000, *.chk -->
                                <CheckBox x:Name="ChkWinRecycle"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeWindows]}" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptWinRecycleTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptWinRecycleDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 6 (Windows): README., ~$*, *.tmp, *.bak -->
                                <CheckBox x:Name="ChkWinTempReadme"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeWindows]}" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptWinTempReadmeTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptWinTempReadmeDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 7 (Linux): .Trash-1000, .directory, .fuse_hidden*, .goutputstream-* -->
                                <CheckBox x:Name="ChkLinuxJunk"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#F3E8FF" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeLinux]}" FontSize="10.5" FontWeight="Bold" Foreground="#7E22CE" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptLinuxTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptLinuxDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Opción 8 (Smart TV): LOST.DIR, LG Smart TV, .android_secure, Android vacía -->
                                <CheckBox x:Name="ChkSmartTvJunk"
                                          IsChecked="True"
                                          Margin="0,0,0,4"
                                          Cursor="Hand">
                                    <StackPanel Margin="6,-2,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Loc[BadgeSmartTv]}" FontSize="10.5" FontWeight="Bold" Foreground="#15803D" />
                                            </Border>
                                            <TextBlock Text="{Binding Loc[OptSmartTvTitle]}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Loc[OptSmartTvDesc]}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Opción Extra: Expulsar automáticamente al terminar -->
                        <Border Grid.Row="2"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,1,0,0"
                                Padding="0,8,0,0"
                                Margin="0,6,0,0">
                            <CheckBox x:Name="ChkAutoEject"
                                      IsChecked="False"
                                      Cursor="Hand">
                                <TextBlock Text="{Binding Loc[OptAutoEjectTitle]}"
                                           Margin="6,-1,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0369A1" />
                            </CheckBox>
                        </Border>
                    </Grid>
                </Border>

                <!-- Botones de Acción Principales -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AnalyzeButton"
                            Grid.Column="0"
                            Style="{StaticResource FluentPrimaryButtonStyle}"
                            Height="46"
                            Click="AnalyzeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[BtnAnalyzeOnly]}" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="EjectUsbButton"
                            Grid.Column="2"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="46"
                            FontSize="13.5"
                            Click="EjectUsbButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏏" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[BtnEjectUsb]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- VISTA B: PESTAÑA / MODAL DE REGISTRO DE ACTIVIDAD EN TIEMPO REAL (LOG) -->
            <Border x:Name="LogActivityPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Título del Log y Estado Actual -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Loc[LogTabTitle]}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LogProgressStatusText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Barra de Progreso -->
                    <ProgressBar x:Name="CleanProgressBar"
                                 Grid.Row="1"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource PrimaryBlueBrush}"
                                 Background="#E2E8F0"
                                 BorderThickness="0"
                                 Margin="0,0,0,10" />

                    <!-- Barra de selección tras análisis (Seleccionar todo / Desmarcar todo) -->
                    <Grid x:Name="DryRunSelectionBar"
                          Grid.Row="2"
                          Visibility="Collapsed"
                          Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Loc[LogDryRunSelectionHint]}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding Loc[BtnSelectAll]}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Click="LogSelectAllButton_Click" />
                            <Button Content="{Binding Loc[BtnDeselectAll]}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Padding="10,4"
                                    FontSize="12"
                                    Click="LogDeselectAllButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Lista detallada línea por línea de archivos y carpetas -->
                    <ListView x:Name="LogListView"
                              Grid.Row="3"
                              BorderBrush="{DynamicResource SecondaryBorderBrush}"
                              BorderThickness="1"
                              FontFamily="Consolas"
                              FontSize="12"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SubCardBgBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="LogCheckColumn" Header="✓" Width="38">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand"
                                                      Checked="LogItemCheckBox_Changed"
                                                      Unchecked="LogItemCheckBox_Changed" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{Binding Loc[LogColType]}" Width="90" DisplayMemberBinding="{Binding TypeDisplay}" />
                                <GridViewColumn Header="{Binding Loc[LogColPath]}" Width="460" DisplayMemberBinding="{Binding FullPath}" />
                                <GridViewColumn Header="{Binding Loc[LogColSize]}" Width="100" DisplayMemberBinding="{Binding SizeDisplay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Resumen Final de Limpieza -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource SummaryBannerBgBrush}"
                            BorderBrush="{DynamicResource SummaryBannerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,12,0,12">
                        <TextBlock x:Name="LogSummaryTextBlock"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SummaryBannerTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Acciones del log: Abortar limpieza, Limpiar seleccionados, Guardar registro (.txt) y Cerrar registro -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AbortCleanButton"
                                Grid.Column="0"
                                Content="{Binding Loc[BtnAbortClean]}"
                                Style="{StaticResource FluentDangerButtonStyle}"
                                Height="38"
                                MinWidth="150"
                                Click="AbortCleanButton_Click" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="DryRunCleanNowButton"
                                    Visibility="Collapsed"
                                    Content="{Binding Loc[BtnCleanUsb]}"
                                    Style="{StaticResource FluentPrimaryButtonStyle}"
                                    Height="38"
                                    Padding="14,0"
                                    FontSize="13.5"
                                    Margin="0,0,10,0"
                                    Click="DryRunCleanNowButton_Click" />

                            <Button x:Name="SaveLogButton"
                                    Content="{Binding Loc[BtnSaveLog]}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Height="38"
                                    Margin="0,0,10,0"
                                    Click="SaveLogButton_Click" />

                            <Button x:Name="CloseLogButton"
                                    Content="{Binding Loc[BtnCloseLog]}"
                                    Style="{StaticResource FluentPrimaryButtonStyle}"
                                    Height="38"
                                    MinWidth="135"
                                    Click="CloseLogButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- VISTA C: APARTADO DE AJUSTES (SEGUNDO PLANO, VERSIÓN Y ACERCA DE) -->
            <Border x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Apartado de Ajustes -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[SettingsPanelTitle]}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[SettingsPanelSubtitle]}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                    <!-- Bloque 1: Idioma, Actualizaciones, Segundo Plano, Modo Oscuro y Menú Contextual -->
                    <Border Background="{DynamicResource SubCardBgBrush}"
                            BorderBrush="{DynamicResource SubCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SettingsGeneralHeader]}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#0369A1"
                                       Margin="0,0,0,10" />

                            <!-- Selector de Idioma dentro de Ajustes -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Loc[SettingsLangTitle]}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[SettingsLangDesc]}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <ComboBox x:Name="LanguageComboBox"
                                          Grid.Column="1"
                                          Width="170"
                                          Height="34"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Content="🇪🇸 Español (ES)" Tag="es-ES" />
                                    <ComboBoxItem Content="🇬🇧 English (EN)" Tag="en-US" />
                                    <ComboBoxItem Content="🇩🇪 Deutsch (DE)" Tag="de-DE" />
                                    <ComboBoxItem Content="🇫🇷 Français (FR)" Tag="fr-FR" />
                                    <ComboBoxItem Content="🇨🇳 中文 (ZH)" Tag="zh-CN" />
                                </ComboBox>
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,2,0,10" />

                            <!-- Sección de Actualizaciones Automáticas (se oculta sola si viene de Microsoft Store) -->
                            <StackPanel x:Name="AutoUpdateSectionPanel">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Loc[OptAutoUpdateTitle]}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Loc[OptAutoUpdateDesc]}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,3" />
                                        <TextBlock x:Name="UpdateStatusTextBlock"
                                                   Text="{Binding Loc[UpdateStatusIdle]}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0284C7" />
                                    </StackPanel>

                                    <Button x:Name="CheckUpdatesButton"
                                            Grid.Column="1"
                                            Content="{Binding Loc[BtnCheckUpdatesNow]}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Height="32"
                                            Padding="12,0"
                                            FontSize="12"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Click="CheckUpdatesButton_Click" />

                                    <CheckBox x:Name="ToggleAutoUpdates"
                                              Grid.Column="2"
                                              IsChecked="True"
                                              Style="{StaticResource FluentToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Checked="ToggleAutoUpdates_Changed"
                                              Unchecked="ToggleAutoUpdates_Changed" />
                                </Grid>

                                <Separator Background="#E2E8F0" Margin="0,2,0,10" />
                            </StackPanel>

                            <!-- Interruptor de Segundo Plano (Bandeja del sistema) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Loc[OptTrayTitle]}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptTrayDesc]}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,4" />
                                    <TextBlock x:Name="TrayStatusIndicatorText"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B" />
                                </StackPanel>

                                <CheckBox x:Name="ToggleBackgroundTray"
                                          Grid.Column="1"
                                          IsChecked="False"
                                          Style="{StaticResource FluentToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="ToggleBackgroundTray_Changed"
                                          Unchecked="ToggleBackgroundTray_Changed" />
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,2,0,10" />

                            <!-- Interruptor de Modo Oscuro (Dark Mode) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Loc[OptDarkModeTitle]}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptDarkModeDesc]}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox x:Name="ToggleDarkMode"
                                          Grid.Column="1"
                                          IsChecked="False"
                                          Style="{StaticResource FluentToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="ToggleDarkMode_Changed"
                                          Unchecked="ToggleDarkMode_Changed" />
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,2,0,10" />

                            <!-- Interruptor de Menú Contextual en el Explorador de Windows -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Loc[OptContextMenuTitle]}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptContextMenuDesc]}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox x:Name="ToggleContextMenu"
                                          Grid.Column="1"
                                          IsChecked="False"
                                          Style="{StaticResource FluentToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="ToggleContextMenu_Changed"
                                          Unchecked="ToggleContextMenu_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bloque 2: Acerca de CleanMacUSB, Versión y Licencia EULA -->
                    <Border Background="{DynamicResource SubCardBgBrush}"
                            BorderBrush="{DynamicResource SubCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Cabecera Acerca de + Botón Invítame a un café (PayPal) + Botón Ventana Completa -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Loc[SettingsAboutSectionHeader]}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#0369A1"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding Loc[BtnDonateCoffee]}"
                                            ToolTip="{Binding Loc[DonateTooltip]}"
                                            Style="{StaticResource FluentDonateButtonStyle}"
                                            Padding="12,5"
                                            FontSize="11.5"
                                            Margin="0,0,8,0"
                                            Click="DonatePayPalButton_Click" />
                                    <Button Content="{Binding Loc[SettingsViewFullEulaBtn]}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Padding="10,4"
                                            FontSize="11.5"
                                            Click="AboutButton_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Ficha de Versión y Autor (Josan Sánchez) -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="pack://application:,,,/Assets/logo.png"
                                       Width="60"
                                       Height="60"
                                       Margin="0,0,14,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Loc[SettingsVersionLabel]}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Loc[SettingsVersionValue]}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Loc[SettingsLicenseTypeLabel]}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Loc[SettingsLicenseTypeValue]}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Foreground="#0284C7" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Loc[SettingsAuthorLabel]}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Loc[SettingsAuthorValue]}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Loc[SettingsRepoLabel]}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Hyperlink NavigateUri="https://github.com/josansancheez/cleanmacusb"
                                                       Foreground="#0284C7"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                https://github.com/josansancheez/cleanmacusb
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Cuadro del Contrato de Licencia (EULA) integrado en Ajustes -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource EulaBoxBgBrush}"
                                    BorderBrush="{DynamicResource SecondaryBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <TextBox x:Name="SettingsEulaTextBox"
                                         Height="165"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Foreground="{DynamicResource EulaTextBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="8,6" />
                            </Border>
                        </Grid>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. BARRA DE ESTADO INFERIOR ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBgBrush}"
                CornerRadius="8"
                Padding="12,7"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="CleanMacUSB v1.0 — © Josan Sánchez"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
