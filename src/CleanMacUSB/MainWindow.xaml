<Window x:Class="CleanMacUSB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMacUSB v1.0 — Josan Sánchez"
        Icon="pack://application:,,,/Assets/CleanMacUSB.ico"
        Width="780"
        Height="650"
        MinWidth="720"
        MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. CABECERA PRINCIPAL ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo Macintosh + USB -->
                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/logo.png"
                       Width="56"
                       Height="56"
                       Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Título y Subtítulo -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[AppTitle]}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="#E0F2FE"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="v1.0 Freeware"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#0369A1" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Loc[AppSubtitle]}"
                               FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Selector de Idioma (ES / EN) + Botón Acerca de -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[LanguageLabel]}"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />

                    <ComboBox x:Name="LanguageComboBox"
                              Width="128"
                              Height="34"
                              VerticalContentAlignment="Center"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Margin="0,0,10,0"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="🇪🇸 Español (ES)" Tag="es-ES" />
                        <ComboBoxItem Content="🇬🇧 English (EN)" Tag="en-US" />
                    </ComboBox>

                    <Button Content="{Binding Loc[AboutButton]}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="34"
                            Click="AboutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. CUERPO CENTRAL (VISTA PRINCIPAL / VISTA DE LOG) ==================== -->
        <Grid Grid.Row="1">

            <!-- VISTA A: PANTALLA PRINCIPAL DE CONFIGURACIÓN Y ACCIÓN -->
            <Grid x:Name="MainConfigPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Selector de Unidad USB -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[UsbSectionTitle]}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Loc[UsbSectionSubtitle]}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="UsbDrivesComboBox"
                                      Grid.Column="0"
                                      Height="38"
                                      FontSize="13.5"
                                      FontWeight="SemiBold"
                                      VerticalContentAlignment="Center"
                                      Padding="10,0"
                                      DisplayMemberPath="DisplayName" />

                            <Button x:Name="RefreshDrivesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Click="RefreshDrivesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="15" FontWeight="Bold" Margin="0,-1,6,0" />
                                    <TextBlock Text="{Binding Loc[RefreshDrivesButton]}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="NoDrivesWarningText"
                                   Text="{Binding Loc[NoUsbDetected]}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#D97706"
                                   Margin="2,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Configuración de Limpieza (Opciones) -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Loc[OptionsSectionTitle]}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <!-- Opción 1: AppleDouble (._*) -->
                            <CheckBox x:Name="ChkAppleDouble"
                                      IsChecked="True"
                                      Margin="0,4,0,10"
                                      Cursor="Hand">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="{Binding Loc[OptAppleDoubleTitle]}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptAppleDoubleDesc]}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>

                            <!-- Opción 2: .DS_Store -->
                            <CheckBox x:Name="ChkDsStore"
                                      IsChecked="True"
                                      Margin="0,2,0,10"
                                      Cursor="Hand">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="{Binding Loc[OptDsStoreTitle]}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptDsStoreDesc]}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>

                            <!-- Opción 3: Spotlight, Trashes, fseventsd, TemporaryItems -->
                            <CheckBox x:Name="ChkSpotlightTrash"
                                      IsChecked="True"
                                      Margin="0,2,0,10"
                                      Cursor="Hand">
                                <StackPanel Margin="6,-2,0,0">
                                    <TextBlock Text="{Binding Loc[OptSpotlightTrashTitle]}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptSpotlightTrashDesc]}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>

                            <!-- Opción Extra: Expulsar automáticamente al terminar -->
                            <CheckBox x:Name="ChkAutoEject"
                                      IsChecked="False"
                                      Margin="0,2,0,6"
                                      Cursor="Hand">
                                <TextBlock Text="{Binding Loc[OptAutoEjectTitle]}"
                                           Margin="6,-1,0,0"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#0369A1" />
                            </CheckBox>
                        </StackPanel>

                        <!-- Interruptor (Toggle) Segundo Plano / Bandeja del Sistema -->
                        <Border Grid.Row="2"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Loc[OptTrayTitle]}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Loc[OptTrayDesc]}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <CheckBox x:Name="ToggleBackgroundTray"
                                          Grid.Column="1"
                                          IsChecked="False"
                                          Style="{StaticResource FluentToggleSwitchStyle}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Botones de Acción Principales -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CleanUsbButton"
                            Grid.Column="0"
                            Style="{StaticResource FluentPrimaryButtonStyle}"
                            Height="48"
                            Click="CleanUsbButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[BtnCleanUsb]}" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="EjectUsbButton"
                            Grid.Column="2"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="48"
                            FontSize="14.5"
                            Click="EjectUsbButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏏" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[BtnEjectUsb]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- VISTA B: PESTAÑA / MODAL DE REGISTRO DE ACTIVIDAD EN TIEMPO REAL (LOG) -->
            <Border x:Name="LogActivityPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Título del Log y Estado Actual -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Loc[LogTabTitle]}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LogProgressStatusText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Barra de Progreso -->
                    <ProgressBar x:Name="CleanProgressBar"
                                 Grid.Row="1"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource PrimaryBlueBrush}"
                                 Background="#E2E8F0"
                                 BorderThickness="0"
                                 Margin="0,0,0,12" />

                    <!-- Lista detallada línea por línea de archivos y carpetas eliminadas -->
                    <ListView x:Name="LogListView"
                              Grid.Row="2"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              FontFamily="Consolas"
                              FontSize="12"
                              Background="#F8FAFC">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{Binding Loc[LogColType]}" Width="95" DisplayMemberBinding="{Binding TypeDisplay}" />
                                <GridViewColumn Header="{Binding Loc[LogColPath]}" Width="465" DisplayMemberBinding="{Binding FullPath}" />
                                <GridViewColumn Header="{Binding Loc[LogColSize]}" Width="105" DisplayMemberBinding="{Binding SizeDisplay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Resumen Final de Limpieza -->
                    <Border Grid.Row="3"
                            Background="#F0F9FF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,12,0,12">
                        <TextBlock x:Name="LogSummaryTextBlock"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#0369A1"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Acciones al finalizar el log: Guardar registro (.txt) y Cerrar registro -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="SaveLogButton"
                                Content="{Binding Loc[BtnSaveLog]}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Height="38"
                                Margin="0,0,10,0"
                                Click="SaveLogButton_Click" />

                        <Button x:Name="CloseLogButton"
                                Content="{Binding Loc[BtnCloseLog]}"
                                Style="{StaticResource FluentPrimaryButtonStyle}"
                                Height="38"
                                MinWidth="135"
                                Click="CloseLogButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. BARRA DE ESTADO INFERIOR ==================== -->
        <Border Grid.Row="2"
                Background="#E2E8F0"
                CornerRadius="8"
                Padding="12,7"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="#334155"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="© Josan Sánchez"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
