; ==============================================================================
; CLEANMACUSB v1.0 — SCRIPT DE INSTALACIÓN PROFESIONAL (INNO SETUP 6)
; Estilo: InstallShield Wizard Clásico
; Desarrollador y Titular de los Derechos: Josan Sánchez
; ==============================================================================

#define MyAppName "CleanMacUSB"
#define MyAppVersion "1.0.0"
#define MyAppDisplayVersion "1.0"
#define MyAppPublisher "Josan Sánchez"
#define MyAppExeName "CleanMacUSB.exe"
#define MyAppId "{{8A4E9B2D-5C71-4F18-9E3A-7D6C2A10B984}"
#ifndef PublishDir
  #define PublishDir "..\src\CleanMacUSB\bin\Release\net8.0-windows\publish"
#endif

[Setup]
AppId={#MyAppId}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} v{#MyAppDisplayVersion}
AppPublisher={#MyAppPublisher}
AppCopyright=Copyright (C) 2026 {#MyAppPublisher}. Todos los derechos reservados.
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableWelcomePage=no
DisableDirPage=no
DisableProgramGroupPage=yes
; Estética clásica estilo InstallShield Wizard
WizardStyle=classic
WizardImageFile=..\assets\wizard_image.bmp
WizardSmallImageFile=..\assets\wizard_small.bmp
SetupIconFile=..\assets\CleanMacUSB.ico
; Paso 8: Registro limpio en Panel de Control > Programas y características
CreateUninstallRegKey=yes
UninstallDisplayName={#MyAppName} v{#MyAppDisplayVersion}
UninstallDisplayIcon={app}\{#MyAppExeName}
; Paso 1: Mostrar siempre selector de idioma inicial (Español / Inglés)
ShowLanguageDialog=yes
UsePreviousLanguage=no
; Permitir instalación tanto para Todos los usuarios como para Usuario actual
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=..\dist
OutputBaseFilename=CleanMacUSB_Setup_v1.0
Compression=lzma2/ultra64
SolidCompression=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"; LicenseFile: "EULA_ES.txt"
Name: "en"; MessagesFile: "compiler:Default.isl"; LicenseFile: "EULA_EN.txt"

[Messages]
; Paso 3: Pantalla de Bienvenida personalizada con agradecimiento de Josan Sánchez
es.WelcomeLabel1=Bienvenido al Asistente de Instalación de CleanMacUSB v1.0
es.WelcomeLabel2=Gracias por descargar e instalar CleanMacUSB, una utilidad gratuita (Freeware) desarrollada por Josan Sánchez para eliminar todos los archivos residuales ocultos que macOS genera en tus memorias USB.%n%nEste asistente le guiará paso a paso durante el proceso de instalación.%n%nSe recomienda cerrar otras aplicaciones antes de continuar. Haga clic en Siguiente para avanzar.
en.WelcomeLabel1=Welcome to the CleanMacUSB v1.0 InstallShield Wizard
en.WelcomeLabel2=Thank you for downloading and installing CleanMacUSB, a Freeware utility developed by Josan Sánchez designed to remove all hidden residual files generated by macOS on your USB drives.%n%nThis wizard will guide you step-by-step through the installation process.%n%nIt is recommended that you close all other applications before continuing. Click Next to continue.

; Paso 9: Casilla en Pantalla Final para ejecutar CleanMacUSB
es.FinishedHeadingLabel=Instalación de CleanMacUSB completada con éxito
es.FinishedLabel=El asistente ha terminado de instalar CleanMacUSB v1.0 (por Josan Sánchez) en su equipo.%n%nPuede iniciar la aplicación desde el Menú Inicio o marcando la casilla inferior.
en.FinishedHeadingLabel=CleanMacUSB Installation Successfully Completed
en.FinishedLabel=The wizard has finished installing CleanMacUSB v1.0 (by Josan Sánchez) on your computer.%n%nYou may launch the application from the Start Menu or by keeping the check box below selected.

[CustomMessages]
; Prerrequisito .NET 8 Desktop Runtime
es.DotNetMissingMsg=CleanMacUSB requiere Microsoft .NET 8 Desktop Runtime (x64), el cual no se ha detectado en el registro de este equipo.%n%n¿Desea que el instalador descargue e instale automáticamente .NET 8 Desktop Runtime desde el servidor oficial de Microsoft antes de continuar?
en.DotNetMissingMsg=CleanMacUSB requires Microsoft .NET 8 Desktop Runtime (x64), which was not detected in the Windows Registry on this computer.%n%nWould you like the installer to automatically download and install .NET 8 Desktop Runtime from Microsoft's official server before continuing?
es.DotNetDownloadingTitle=Descargando Microsoft .NET 8 Desktop Runtime...
en.DotNetDownloadingTitle=Downloading Microsoft .NET 8 Desktop Runtime...
es.DotNetDownloadFailed=No se pudo completar la descarga automática. Se abrirá la página oficial de descarga de Microsoft .NET 8 Desktop Runtime en su navegador.
en.DotNetDownloadFailed=Automatic download could not be completed. Microsoft's official .NET 8 Desktop Runtime download page will now open in your browser.

; Paso 4: Página Condicional de Detección de Instalación Previa
es.PrevInstallTitle=Instalación previa de CleanMacUSB detectada
en.PrevInstallTitle=Previous CleanMacUSB Installation Detected
es.PrevInstallSubTitle=Ya existe una versión instalada de CleanMacUSB en este sistema.
en.PrevInstallSubTitle=An existing installation of CleanMacUSB was found on this system.
es.PrevInstallBody=El asistente ha detectado que CleanMacUSB ya se encuentra instalado en la siguiente ruta:%n%n%1%n%nPara garantizar una actualización limpia y sin conflictos, es necesario desinstalar primero la versión existente antes de continuar con esta instalación.
en.PrevInstallBody=The setup wizard detected that CleanMacUSB is already installed at the following location:%n%n%1%n%nTo ensure a clean and conflict-free update, the existing version must be uninstalled first before proceeding with this installation.
es.PrevInstallBtnUninstall=Ejecutar desinstalador de la versión anterior ahora
en.PrevInstallBtnUninstall=Run existing version uninstaller now
es.PrevInstallUninstalledOk=Estado: La versión anterior ha sido desinstalada correctamente. Ya puede pulsar «Siguiente >» para continuar.
en.PrevInstallUninstalledOk=Status: The previous version was successfully uninstalled. You may now click "Next >" to continue.
es.PrevInstallMustUninstall=Por favor, ejecute el desinstalador de la versión anterior usando el botón en pantalla antes de pulsar Siguiente.
en.PrevInstallMustUninstall=Please run the uninstaller for the existing version using the button on screen before clicking Next.

; Paso 5: Acuerdo de Licencia (EULA) con Lectura Obligatoria hasta el final
es.EulaScrollHint=⚠ Desplácese con la barra de lectura hasta el final del contrato EULA para habilitar la opción «Acepto el acuerdo» y el botón «Siguiente >».
en.EulaScrollHint=⚠ Please scroll all the way down to the bottom of the EULA agreement to enable "I accept the agreement" and the "Next >" button.
es.EulaScrolledReady=✔ Lectura del contrato completada. Ya puede aceptar los términos y pulsar «Siguiente >».
en.EulaScrolledReady=✔ License reading completed. You can now accept the terms and click "Next >".

; Paso 6: Tipo de Instalación (Todos los usuarios vs Usuario actual)
es.ScopePageTitle=Tipo de Instalación
en.ScopePageTitle=Installation Scope
es.ScopePageSubTitle=Seleccione para quién desea instalar CleanMacUSB en este equipo.
en.ScopePageSubTitle=Select who should have access to CleanMacUSB on this computer.
es.ScopePageHeader=Elija el modo de instalación preferido (en el siguiente paso podrá confirmar o cambiar la carpeta en la unidad C:):
en.ScopePageHeader=Choose your preferred installation mode (in the next step you can confirm or browse for another folder on drive C:):
es.ScopeAllUsers=Instalar para todos los usuarios del equipo (Ruta por defecto: C:\Program Files\CleanMacUSB)
en.ScopeAllUsers=Install for all users on this computer (Default path: C:\Program Files\CleanMacUSB)
es.ScopeCurrentUser=Instalar solo para el usuario actual (Sin permisos elevados, ruta en C:\Users\...\CleanMacUSB)
en.ScopeCurrentUser=Install only for the current user (No elevation needed, path in C:\Users\...\CleanMacUSB)

; Tareas y Ejecución Final
es.CreateDesktopIcon=Crear un icono de acceso directo en el &Escritorio
en.CreateDesktopIcon=Create a &Desktop shortcut icon
es.LaunchAppAfterInstall=Ejecutar CleanMacUSB al finalizar
en.LaunchAppAfterInstall=Launch CleanMacUSB

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "{#PublishDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\assets\CleanMacUSB.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "EULA_ES.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "EULA_EN.txt"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\CleanMacUSB.ico"
Name: "{group}\Uninstall {#MyAppName}"; Filename: "{uninstallexe}"; IconFilename: "{app}\CleanMacUSB.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\CleanMacUSB.ico"; Tasks: desktopicon

[Run]
; Paso 9: Casilla marcada por defecto en la pantalla final para abrir CleanMacUSB automáticamente
Filename: "{app}\{#MyAppExeName}"; Parameters: "--lang={language}"; Description: "{cm:LaunchAppAfterInstall}"; Flags: nowait postinstall skipifsilent

[Code]
type
  SCROLLINFO = record
    cbSize: UINT;
    fMask: UINT;
    nMin: Integer;
    nMax: Integer;
    nPage: UINT;
    nPos: Integer;
    nTrackPos: Integer;
  end;

const
  SB_VERT = 1;
  SIF_RANGE = $0001;
  SIF_PAGE  = $0002;
  SIF_POS   = $0004;
  SIF_ALL   = (SIF_RANGE or SIF_PAGE or SIF_POS);

function GetScrollInfo(hWnd: HWND; BarFlag: Integer; var ScrollInfo: SCROLLINFO): BOOL;
  external 'GetScrollInfo@user32.dll stdcall';

function SetTimer(hWnd: HWND; nIDEvent: UINT_PTR; uElapse: UINT; lpTimerFunc: LongWord): UINT_PTR;
  external 'SetTimer@user32.dll stdcall';

var
  PrevInstallPage: TWizardPage;
  PrevInstallBtn: TNewButton;
  PrevInstallStatusLbl: TNewStaticText;
  PrevUninstallCmd: String;
  PrevInstallLocation: String;
  HasPreviousInstall: Boolean;
  PrevUninstallCompleted: Boolean;

  ScopePage: TWizardPage;
  RadioAllUsers: TNewRadioButton;
  RadioCurrentUser: TNewRadioButton;

  EulaHintLabel: TNewStaticText;
  EulaHasScrolledToBottom: Boolean;

  DownloadPage: TDownloadWizardPage;
  DotNetVerified: Boolean;

// ==============================================================================
// PASO 2: COMPROBACIÓN DE PRERREQUISITOS (.NET 8 DESKTOP RUNTIME EN EL REGISTRO)
// ==============================================================================
function IsDotNet8DesktopRuntimeInstalled(): Boolean;
var
  Names: TArrayOfString;
  I: Integer;
  FindRec: TFindRec;
begin
  Result := False;

  // 1. Comprobar en Registro HKLM (64-bit y WOW6432Node)
  if RegGetValueNames(HKLM64, 'SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App', Names) then
  begin
    for I := 0 to GetArrayLength(Names) - 1 do
    begin
      if Pos('8.', Names[I]) = 1 then
      begin
        Result := True;
        Exit;
      end;
    end;
  end;

  if RegGetValueNames(HKLM, 'SOFTWARE\WOW6432Node\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App', Names) then
  begin
    for I := 0 to GetArrayLength(Names) - 1 do
    begin
      if Pos('8.', Names[I]) = 1 then
      begin
        Result := True;
        Exit;
      end;
    end;
  end;

  // 2. Comprobar rutas estándar en disco (Program Files y perfil de usuario)
  if FindFirst(ExpandConstant('{autopf64}\dotnet\shared\Microsoft.WindowsDesktop.App\8.*'), FindRec) then
  begin
    FindClose(FindRec);
    Result := True;
    Exit;
  end;

  if FindFirst(ExpandConstant('{%USERPROFILE}\.dotnet\shared\Microsoft.WindowsDesktop.App\8.*'), FindRec) then
  begin
    FindClose(FindRec);
    Result := True;
    Exit;
  end;
end;

// ==============================================================================
// PASO 4: DETECCIÓN DE INSTALACIÓN PREVIA DE CLEANMACUSB EN EL REGISTRO
// ==============================================================================
procedure DetectExistingCleanMacUSBInstallation();
var
  UninstKey: String;
begin
  HasPreviousInstall := False;
  PrevUninstallCompleted := False;
  PrevUninstallCmd := '';
  PrevInstallLocation := '';

  UninstKey := 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{8A4E9B2D-5C71-4F18-9E3A-7D6C2A10B984}_is1';

  if RegQueryStringValue(HKLM64, UninstKey, 'UninstallString', PrevUninstallCmd) then
  begin
    RegQueryStringValue(HKLM64, UninstKey, 'Inno Setup: App Path', PrevInstallLocation);
    HasPreviousInstall := (PrevUninstallCmd <> '');
    Exit;
  end;

  if RegQueryStringValue(HKCU, UninstKey, 'UninstallString', PrevUninstallCmd) then
  begin
    RegQueryStringValue(HKCU, UninstKey, 'Inno Setup: App Path', PrevInstallLocation);
    HasPreviousInstall := (PrevUninstallCmd <> '');
    Exit;
  end;
end;

procedure OnRunPreviousUninstallerClick(Sender: TObject);
var
  ExePath: String;
  ResultCode: Integer;
begin
  ExePath := RemoveQuotes(PrevUninstallCmd);
  if Exec(ExePath, '/SILENT /NORESTART', '', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
  begin
    if ResultCode = 0 then
    begin
      PrevUninstallCompleted := True;
      PrevInstallBtn.Enabled := False;
      PrevInstallStatusLbl.Caption := CustomMessage('PrevInstallUninstalledOk');
      PrevInstallStatusLbl.Font.Color := clGreen;
      WizardForm.NextButton.Enabled := True;
    end;
  end;
end;

// ==============================================================================
// PASO 5: LECTURA OBLIGATORIA DEL EULA HASTA EL FINAL (SCROLL DETECTION)
// ==============================================================================
procedure CheckLicenseScrollPosition();
var
  SI: SCROLLINFO;
begin
  if EulaHasScrolledToBottom then Exit;

  SI.cbSize := SizeOf(SI);
  SI.fMask := SIF_ALL;

  if GetScrollInfo(WizardForm.LicenseMemo.Handle, SB_VERT, SI) then
  begin
    // Si el texto cabe entero o si el usuario ha bajado el scroll hasta el final
    if (SI.nMax <= Integer(SI.nPage)) or ((SI.nPos + Integer(SI.nPage)) >= (SI.nMax - 12)) then
    begin
      EulaHasScrolledToBottom := True;
      WizardForm.LicenseAcceptedRadio.Enabled := True;
      if EulaHintLabel <> nil then
      begin
        EulaHintLabel.Caption := CustomMessage('EulaScrolledReady');
        EulaHintLabel.Font.Color := clGreen;
      end;
      if WizardForm.LicenseAcceptedRadio.Checked then
      begin
        WizardForm.NextButton.Enabled := True;
      end;
    end;
  end;
end;

procedure LicenseMemoScrollCheckEvent(Sender: TObject);
begin
  CheckLicenseScrollPosition();
end;

procedure LicenseMemoKeyEvent(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  CheckLicenseScrollPosition();
end;

procedure ScrollCheckTimerProc(hWnd: LongWord; uMsg: LongWord; idEvent: LongWord; dwTime: LongWord);
begin
  if (WizardForm <> nil) and (WizardForm.CurPageID = wpLicense) then
  begin
    CheckLicenseScrollPosition();
  end;
end;

// ==============================================================================
// INICIALIZACIÓN DEL ASISTENTE Y PÁGINAS PERSONALIZADAS
// ==============================================================================
procedure InitializeWizard();
var
  BodyLbl: TNewStaticText;
  ScopeHeaderLbl: TNewStaticText;
begin
  DotNetVerified := IsDotNet8DesktopRuntimeInstalled();
  DetectExistingCleanMacUSBInstallation();

  DownloadPage := CreateDownloadPage(
    CustomMessage('DotNetDownloadingTitle'),
    'Microsoft .NET 8 Desktop Runtime (x64)',
    nil);

  // ---- PASO 4: PÁGINA CONDICIONAL DE INSTALACIÓN PREVIA ----
  PrevInstallPage := CreateCustomPage(
    wpWelcome,
    CustomMessage('PrevInstallTitle'),
    CustomMessage('PrevInstallSubTitle'));

  BodyLbl := TNewStaticText.Create(PrevInstallPage);
  BodyLbl.Parent := PrevInstallPage.Surface;
  BodyLbl.Left := 0;
  BodyLbl.Top := 0;
  BodyLbl.Width := PrevInstallPage.SurfaceWidth;
  BodyLbl.AutoSize := True;
  BodyLbl.WordWrap := True;
  if PrevInstallLocation <> '' then
    BodyLbl.Caption := Format(CustomMessage('PrevInstallBody'), [PrevInstallLocation])
  else
    BodyLbl.Caption := Format(CustomMessage('PrevInstallBody'), [PrevUninstallCmd]);

  PrevInstallBtn := TNewButton.Create(PrevInstallPage);
  PrevInstallBtn.Parent := PrevInstallPage.Surface;
  PrevInstallBtn.Left := 0;
  PrevInstallBtn.Top := BodyLbl.Top + BodyLbl.Height + ScaleY(18);
  PrevInstallBtn.Width := ScaleX(340);
  PrevInstallBtn.Height := ScaleY(32);
  PrevInstallBtn.Caption := CustomMessage('PrevInstallBtnUninstall');
  PrevInstallBtn.OnClick := @OnRunPreviousUninstallerClick;

  PrevInstallStatusLbl := TNewStaticText.Create(PrevInstallPage);
  PrevInstallStatusLbl.Parent := PrevInstallPage.Surface;
  PrevInstallStatusLbl.Left := 0;
  PrevInstallStatusLbl.Top := PrevInstallBtn.Top + PrevInstallBtn.Height + ScaleY(16);
  PrevInstallStatusLbl.Width := PrevInstallPage.SurfaceWidth;
  PrevInstallStatusLbl.WordWrap := True;
  PrevInstallStatusLbl.Font.Style := [fsBold];
  PrevInstallStatusLbl.Caption := '';

  // ---- PASO 5: CONFIGURAR LECTURA OBLIGATORIA DEL EULA ----
  EulaHasScrolledToBottom := False;
  WizardForm.LicenseMemo.Height := WizardForm.LicenseMemo.Height - ScaleY(22);
  WizardForm.LicenseMemo.OnClick := @LicenseMemoScrollCheckEvent;
  WizardForm.LicenseMemo.OnKeyUp := @LicenseMemoKeyEvent;

  EulaHintLabel := TNewStaticText.Create(WizardForm.LicensePage);
  EulaHintLabel.Parent := WizardForm.LicensePage;
  EulaHintLabel.Left := WizardForm.LicenseMemo.Left;
  EulaHintLabel.Top := WizardForm.LicenseMemo.Top + WizardForm.LicenseMemo.Height + ScaleY(4);
  EulaHintLabel.Width := WizardForm.LicenseMemo.Width;
  EulaHintLabel.WordWrap := True;
  EulaHintLabel.Font.Color := $000045B5;
  EulaHintLabel.Font.Style := [fsBold];
  EulaHintLabel.Caption := CustomMessage('EulaScrollHint');

  SetTimer(WizardForm.Handle, 1, 150, CreateCallback(@ScrollCheckTimerProc));

  // ---- PASO 6: PÁGINA DE TIPO DE INSTALACIÓN (TODOS LOS USUARIOS vs USUARIO ACTUAL) ----
  ScopePage := CreateCustomPage(
    wpLicense,
    CustomMessage('ScopePageTitle'),
    CustomMessage('ScopePageSubTitle'));

  ScopeHeaderLbl := TNewStaticText.Create(ScopePage);
  ScopeHeaderLbl.Parent := ScopePage.Surface;
  ScopeHeaderLbl.Left := 0;
  ScopeHeaderLbl.Top := 0;
  ScopeHeaderLbl.Width := ScopePage.SurfaceWidth;
  ScopeHeaderLbl.WordWrap := True;
  ScopeHeaderLbl.Caption := CustomMessage('ScopePageHeader');

  RadioAllUsers := TNewRadioButton.Create(ScopePage);
  RadioAllUsers.Parent := ScopePage.Surface;
  RadioAllUsers.Left := ScaleX(8);
  RadioAllUsers.Top := ScopeHeaderLbl.Top + ScopeHeaderLbl.Height + ScaleY(18);
  RadioAllUsers.Width := ScopePage.SurfaceWidth - ScaleX(16);
  RadioAllUsers.Height := ScaleY(26);
  RadioAllUsers.Caption := CustomMessage('ScopeAllUsers');
  RadioAllUsers.Checked := IsAdminInstallMode();

  RadioCurrentUser := TNewRadioButton.Create(ScopePage);
  RadioCurrentUser.Parent := ScopePage.Surface;
  RadioCurrentUser.Left := ScaleX(8);
  RadioCurrentUser.Top := RadioAllUsers.Top + RadioAllUsers.Height + ScaleY(10);
  RadioCurrentUser.Width := ScopePage.SurfaceWidth - ScaleX(16);
  RadioCurrentUser.Height := ScaleY(26);
  RadioCurrentUser.Caption := CustomMessage('ScopeCurrentUser');
  RadioCurrentUser.Checked := not IsAdminInstallMode();
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  // Paso 4: Si NO detecta ninguna versión previa de CleanMacUSB, esta pantalla se salta automáticamente
  if PageID = PrevInstallPage.ID then
  begin
    Result := not HasPreviousInstall;
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  // En la pantalla de versión previa detectada, deshabilitar Siguiente hasta que se desinstale
  if CurPageID = PrevInstallPage.ID then
  begin
    WizardForm.NextButton.Enabled := PrevUninstallCompleted;
  end;

  // En la pantalla de Acuerdo de Licencia (EULA), bloquear Acepto y Siguiente hasta hacer scroll al final
  if CurPageID = wpLicense then
  begin
    if not EulaHasScrolledToBottom then
    begin
      WizardForm.LicenseNotAcceptedRadio.Checked := True;
      WizardForm.LicenseAcceptedRadio.Enabled := False;
      WizardForm.NextButton.Enabled := False;
    end;
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  ResultCode: Integer;
  DotNetInstallerPath: String;
begin
  Result := True;

  // Paso 2: Al avanzar desde la Bienvenida, comprobar prerrequisito .NET 8 Desktop Runtime
  if (CurPageID = wpWelcome) and (not DotNetVerified) then
  begin
    DotNetVerified := IsDotNet8DesktopRuntimeInstalled();
    if not DotNetVerified then
    begin
      if MsgBox(CustomMessage('DotNetMissingMsg'), mbConfirmation, MB_YESNO) = IDYES then
      begin
        DownloadPage.Clear;
        DownloadPage.Add('https://aka.ms/dotnet/8.0/windowsdesktop-runtime-win-x64.exe', 'windowsdesktop-runtime-win-x64.exe', '');
        DownloadPage.Show;
        try
          try
            DownloadPage.Download;
            DotNetInstallerPath := ExpandConstant('{tmp}\windowsdesktop-runtime-win-x64.exe');
            if Exec(DotNetInstallerPath, '/install /passive /norestart', '', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
            begin
              DotNetVerified := True;
            end;
          except
            MsgBox(CustomMessage('DotNetDownloadFailed'), mbInformation, MB_OK);
            ShellExec('open', 'https://dotnet.microsoft.com/en-us/download/dotnet/8.0', '', '', SW_SHOWNORMAL, ewNoWait, ResultCode);
            Result := False;
          end;
        finally
          DownloadPage.Hide;
        end;
      end
      else
      begin
        Result := False;
        Exit;
      end;
    end;
  end;

  // Paso 4: Verificar que la versión anterior se haya desinstalado si la página estaba activa
  if (CurPageID = PrevInstallPage.ID) and HasPreviousInstall and (not PrevUninstallCompleted) then
  begin
    MsgBox(CustomMessage('PrevInstallMustUninstall'), mbError, MB_OK);
    Result := False;
    Exit;
  end;

  // Paso 6: Ajustar la ruta predeterminada en unidad C: según el tipo de instalación elegido
  if CurPageID = ScopePage.ID then
  begin
    if RadioAllUsers.Checked then
    begin
      WizardForm.DirEdit.Text := ExpandConstant('{commonpf}\{#MyAppName}');
    end
    else
    begin
      WizardForm.DirEdit.Text := ExpandConstant('{localappdata}\Programs\{#MyAppName}');
    end;
  end;
end;
